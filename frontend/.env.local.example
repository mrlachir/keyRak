# Auth.js / NextAuth session configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-separate-random-session-secret

# Google OAuth application credentials
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Spring Boot API token contract. JWT_SECRET must exactly match backend/JWT_SECRET.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=keyrak-nextauth
JWT_AUDIENCE=keyrak-api
BACKEND_API_URL=http://localhost:8080

# Optional public contact destinations shown on /contact. Leave empty until confirmed.
SUPPORT_EMAIL=
SUPPORT_PHONE=
