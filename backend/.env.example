MYSQL_URL=jdbc:mysql://localhost:3306/keyrak_marketplace?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
MYSQL_USERNAME=keyrak_user
MYSQL_PASSWORD=change-me

# At least 32 bytes. The same server-side value must sign the frontend-issued HS256 API token.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=keyrak-nextauth
JWT_AUDIENCE=keyrak-api

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GEMINI_API_KEY=replace-with-gemini-api-key
CORS_ALLOWED_ORIGINS=http://localhost:3000
