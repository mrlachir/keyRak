# Copy this file to .env. Never commit production values.
MYSQL_DATABASE=keyrak_marketplace
MYSQL_USERNAME=keyrak_user
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-long-random-root-password

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-separate-random-secret-at-least-32-bytes
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# This exact value is mounted into both frontend and backend containers.
JWT_SECRET=replace-with-a-random-shared-secret-at-least-32-bytes
JWT_ISSUER=keyrak-nextauth
JWT_AUDIENCE=keyrak-api

GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

FRONTEND_PORT=3000
BACKEND_PORT=8080
BACKEND_PUBLIC_URL=http://localhost:8080
